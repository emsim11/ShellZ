# ~/ZSH_DIR/Lib/Shared/Global_Variables.zsh
# ─────────────────────────────────────────────────────────────────────────────
# Global Variables Used Across ShellZ Framework
# ─────────────────────────────────────────────────────────────────────────────

: "${ZSH_DIR:=$HOME/ShellZ}"
: "${ZSH_BACKUP_DIR:=$ZSH_DIR/Backup}"
: "${ZSH_CACHE_DIR:=$ZSH_DIR/Cache}"
: "${ZSH_CUSTOM_DIR:=$ZSH_DIR/Custom}"
: "${ZSH_LIB_DIR:=$ZSH_DIR/Lib}"
: "${ZSH_LOGS_DIR:=$ZSH_DIR/Logs}"
: "${ZSH_TEMPLATES_DIR:=$ZSH_DIR/Templates}"
: "${ZSH_THEMES_DIR:=$ZSH_DIR/Templates}"
: "${ZSH_TOOLS_DIR:=$ZSH_DIR/Tools}"
: "${ZSH_FUNCTIONS_DIR:=$ZSH_LIB_DIR/Functions}"
: "${ZSH_MODULES_DIR:=$ZSH_LIB_DIR/Modules}"
: "${ZSH_PLUGINS_DIR:=$ZSH_LIB_DIR/Plugins}"
: "${ZSH_SHARED_DIR:=$ZSH_LIB_DIR/Shared}"

: "${ZLOGIN_FILE:=$HOME/.zlogin}"
: "${ZLOGOUT_FILE:=$HOME/.zlogout}"
